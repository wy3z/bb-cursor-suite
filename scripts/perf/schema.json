{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wy3z/bb-cursor-suite/scripts/perf/schema.json",
  "title": "BB performance run",
  "type": "object",
  "required": [
    "arm",
    "plugins",
    "suiteSha",
    "bbVersion",
    "machine",
    "runIndex",
    "order",
    "cold",
    "metrics",
    "errors",
    "valid"
  ],
  "additionalProperties": false,
  "properties": {
    "arm": { "type": "string", "minLength": 1 },
    "plugins": { "type": "array", "items": { "type": "string" } },
    "suiteSha": { "type": "string" },
    "bbVersion": { "type": "string" },
    "machine": {
      "type": "object",
      "required": ["nproc", "memMB", "loadavg"],
      "additionalProperties": false,
      "properties": {
        "nproc": { "type": "integer", "minimum": 1 },
        "memMB": { "type": "integer", "minimum": 1 },
        "loadavg": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "runIndex": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "cold": { "type": "boolean" },
    "valid": { "type": "boolean" },
    "invalidReasons": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "object",
      "required": [
        "navToSidebarMs",
        "domContentLoadedMs",
        "jsBytes",
        "requestCount",
        "longTaskCount",
        "longTaskMs",
        "threadOpenMs",
        "threadOpenRequests",
        "serverRssMB",
        "serverIdleCpuPct60s"
      ],
      "additionalProperties": false,
      "properties": {
        "navToSidebarMs": { "type": "number", "minimum": 0 },
        "domContentLoadedMs": { "type": "number", "minimum": 0 },
        "jsBytes": { "type": "integer", "minimum": 0 },
        "requestCount": { "type": "integer", "minimum": 0 },
        "longTaskCount": { "type": "integer", "minimum": 0 },
        "longTaskMs": { "type": "number", "minimum": 0 },
        "threadOpenMs": {
          "type": "object",
          "required": ["median", "p90", "samples"],
          "additionalProperties": false,
          "properties": {
            "median": { "type": "number", "minimum": 0 },
            "p90": { "type": "number", "minimum": 0 },
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["threadId", "title", "kind", "cold", "ms", "requests", "bytes", "longTaskCount", "longTaskMs"],
                "additionalProperties": false,
                "properties": {
                  "threadId": { "type": "string" },
                  "title": { "type": "string" },
                  "kind": { "enum": ["short", "long"] },
                  "cold": { "type": "boolean" },
                  "ms": { "type": "number", "minimum": 0 },
                  "requests": { "type": "integer", "minimum": 0 },
                  "bytes": { "type": "integer", "minimum": 0 },
                  "longTaskCount": { "type": "integer", "minimum": 0 },
                  "longTaskMs": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "threadOpenRequests": {
          "type": "object",
          "required": ["requests", "bytes", "threadId", "cold"],
          "additionalProperties": false,
          "properties": {
            "requests": { "type": "integer", "minimum": 0 },
            "bytes": { "type": "integer", "minimum": 0 },
            "threadId": { "type": "string" },
            "cold": { "type": "boolean" }
          }
        },
        "serverRssMB": { "type": "number", "minimum": 0 },
        "serverIdleCpuPct60s": { "type": "number", "minimum": 0 }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "additionalProperties": true,
        "properties": {
          "kind": { "enum": ["request", "console", "plugin-load", "harness"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
