{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wy3z/bb-cursor-suite/scripts/perf/schema.json",
  "title": "BB performance run",
  "type": "object",
  "required": [
    "arm",
    "plugins",
    "suiteSha",
    "bbVersion",
    "machine",
    "runIndex",
    "order",
    "cold",
    "metrics",
    "errors",
    "valid"
  ],
  "additionalProperties": false,
  "properties": {
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suiteSha": {
      "type": "string"
    },
    "bbVersion": {
      "type": "string"
    },
    "machine": {
      "type": "object",
      "required": [
        "nproc",
        "memMB",
        "loadavg"
      ],
      "additionalProperties": false,
      "properties": {
        "nproc": {
          "type": "integer",
          "minimum": 1
        },
        "memMB": {
          "type": "integer",
          "minimum": 1
        },
        "loadavg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "runIndex": {
      "type": "integer",
      "minimum": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "cold": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean"
    },
    "invalidReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "navToSidebarMs",
        "domContentLoadedMs",
        "jsBytes",
        "requestCount",
        "longTaskCount",
        "longTaskMs",
        "threadOpenMs",
        "threadOpenRequests",
        "serverRssMB",
        "serverIdleCpuPct60s",
        "bootJsBytes",
        "bootRequestCount",
        "bootEndMs",
        "openJsBytes",
        "openJsBytesMedian",
        "sessionJsBytes",
        "unattributedJsBytes",
        "pluginAppUrls",
        "fixtureVersion",
        "fakeGhCalls",
        "sidebarThreadRows",
        "prTextVisible",
        "threadOpenByKind",
        "openTaskMsMedian",
        "openScriptMsMedian",
        "openLayoutMsMedian",
        "openStyleMsMedian",
        "openLayoutCountMedian",
        "openStyleCountMedian",
        "openLongTaskMsMedian",
        "opensExpected",
        "opensCompleted",
        "settleMs",
        "settled",
        "serverCpuMsDuringOpens",
        "serverCpuMsPerOpen"
      ],
      "additionalProperties": false,
      "properties": {
        "navToSidebarMs": {
          "type": "number",
          "minimum": 0
        },
        "domContentLoadedMs": {
          "type": "number",
          "minimum": 0
        },
        "jsBytes": {
          "type": "integer",
          "minimum": 0
        },
        "requestCount": {
          "type": "integer",
          "minimum": 0
        },
        "longTaskCount": {
          "type": "integer",
          "minimum": 0
        },
        "longTaskMs": {
          "type": "number",
          "minimum": 0
        },
        "threadOpenMs": {
          "type": "object",
          "required": [
            "median",
            "p90",
            "samples"
          ],
          "additionalProperties": false,
          "properties": {
            "median": {
              "type": "number",
              "minimum": 0
            },
            "p90": {
              "type": "number",
              "minimum": 0
            },
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "threadId",
                  "title",
                  "kind",
                  "cold",
                  "ms",
                  "requests",
                  "bytes",
                  "longTaskCount",
                  "longTaskMs",
                  "jsBytes",
                  "taskMs",
                  "scriptMs",
                  "layoutMs",
                  "styleMs",
                  "layoutCount",
                  "styleCount"
                ],
                "additionalProperties": false,
                "properties": {
                  "threadId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "short",
                      "long"
                    ]
                  },
                  "cold": {
                    "type": "boolean"
                  },
                  "ms": {
                    "type": "number",
                    "minimum": 0
                  },
                  "requests": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "longTaskCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "longTaskMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "jsBytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "taskMs": {
                    "type": "number"
                  },
                  "scriptMs": {
                    "type": "number"
                  },
                  "layoutMs": {
                    "type": "number"
                  },
                  "styleMs": {
                    "type": "number"
                  },
                  "layoutCount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "styleCount": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "threadOpenRequests": {
          "type": "object",
          "required": [
            "requests",
            "bytes",
            "threadId",
            "cold"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "threadId": {
              "type": "string"
            },
            "cold": {
              "type": "boolean"
            }
          }
        },
        "serverRssMB": {
          "type": "number",
          "minimum": 0
        },
        "serverIdleCpuPct60s": {
          "type": "number",
          "minimum": 0
        },
        "bootJsBytes": {
          "type": "integer",
          "minimum": 0
        },
        "bootRequestCount": {
          "type": "integer",
          "minimum": 0
        },
        "bootEndMs": {
          "type": "number",
          "minimum": 0
        },
        "openJsBytes": {
          "type": "integer",
          "minimum": 0
        },
        "openJsBytesMedian": {
          "type": "number",
          "minimum": 0
        },
        "sessionJsBytes": {
          "type": "integer",
          "minimum": 0
        },
        "unattributedJsBytes": {
          "type": "integer",
          "minimum": 0
        },
        "pluginAppUrls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "url",
              "bytes",
              "expected",
              "boot"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "expected": {
                "type": "boolean"
              },
              "boot": {
                "type": "boolean"
              }
            }
          }
        },
        "fixtureVersion": {
          "type": "integer",
          "minimum": 0
        },
        "fakeGhCalls": {
          "type": "integer",
          "minimum": 0
        },
        "sidebarThreadRows": {
          "type": "integer",
          "minimum": 0
        },
        "prTextVisible": {
          "type": "boolean"
        },
        "threadOpenByKind": {
          "type": "object",
          "required": [
            "longCold",
            "longWarm",
            "shortCold",
            "shortWarm"
          ],
          "additionalProperties": false,
          "properties": {
            "longCold": {
              "type": "number",
              "minimum": 0
            },
            "longWarm": {
              "type": "number",
              "minimum": 0
            },
            "shortCold": {
              "type": "number",
              "minimum": 0
            },
            "shortWarm": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "openTaskMsMedian": {
          "type": "number",
          "minimum": 0
        },
        "openScriptMsMedian": {
          "type": "number",
          "minimum": 0
        },
        "openLayoutMsMedian": {
          "type": "number",
          "minimum": 0
        },
        "openStyleMsMedian": {
          "type": "number",
          "minimum": 0
        },
        "openLayoutCountMedian": {
          "type": "number",
          "minimum": 0
        },
        "openStyleCountMedian": {
          "type": "number",
          "minimum": 0
        },
        "openLongTaskMsMedian": {
          "type": "number",
          "minimum": 0
        },
        "opensExpected": {
          "type": "integer",
          "minimum": 0
        },
        "opensCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "settleMs": {
          "type": "number",
          "minimum": 0
        },
        "settled": {
          "type": "boolean"
        },
        "serverCpuMsDuringOpens": {
          "type": "number",
          "minimum": 0
        },
        "serverCpuMsPerOpen": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "enum": [
              "request",
              "console",
              "plugin-load",
              "harness"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
